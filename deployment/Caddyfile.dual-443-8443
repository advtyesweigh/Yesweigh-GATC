# Dual HTTPS: serve API on both :443 and :8443 (tls internal).
# Use until portless :443 is confirmed externally; then switch to Caddyfile / tls-internal.
{
	skip_install_trust
}

gatc.yesweigh.in {
	tls internal
	encode gzip
	reverse_proxy 127.0.0.1:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

gatc.yesweigh.in:8443 {
	tls internal
	encode gzip
	reverse_proxy 127.0.0.1:3000
	header {
		-Server
	}
}
