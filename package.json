{
  "name": "gatc-vps",
  "version": "0.1.0",
  "private": true,
  "description": "GATC stamping management — original verification and re-verification via eMaap",
  "workspaces": [
    "backend",
    "frontend",
    "automation"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npm run dev --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "yesgatc:export-users": "node scripts/export-yesgatc-users.mjs",
    "yesgatc:import-users": "node scripts/import-yesgatc-users.mjs",
    "yesgatc:export-certs": "node scripts/export-yesgatc-certs.mjs",
    "yesgatc:import-certs": "node scripts/import-yesgatc-certs.mjs",
    "yesgatc:download-cert-media": "node scripts/download-yesgatc-cert-media.mjs",
    "yesgatc:download-image-media": "node scripts/download-yesgatc-image-media.mjs",
    "yesgatc:download-product-media": "node scripts/download-yesgatc-product-media.mjs",
    "yesgatc:download-vehicle-media": "node scripts/download-yesgatc-vehicle-media.mjs",
    "yesgatc:cleanup-ov-media": "node scripts/cleanup-ov-media-retention.mjs",
    "yesgatc:verify-certs": "node scripts/verify-cert-counts.mjs",
    "yesgatc:sync": "node scripts/sync-yesgatc.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
