# Copy to .env and fill in values. Never commit .env.

# Application
NODE_ENV=development
APP_NAME=gatc-vps
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info

# Backend
API_BASE_URL=http://127.0.0.1:3000
