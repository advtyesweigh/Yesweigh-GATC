# Copy to .env and fill in values. Never commit .env.

# Application
NODE_ENV=development
APP_NAME=gatc-vps
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info

# Backend
API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:3000

# Database (PostgreSQL; localhost only on VPS)
# Example: postgresql://gatc:CHANGE_ME@127.0.0.1:5432/gatc
DATABASE_URL=

# Filesystem data root (VPS: C:\GATC\data — Mac: absolute path under the repo or ~/gatc-data)
DATA_ROOT=

# Auth (required for M1 JWT; generate a long random string)
JWT_SECRET=

# Future: government portal (manual operator-assisted only)
# EMAAP_PORTAL_URL=
# EMAAP_API_BASE_URL=

# Deployment (set on VPS only; keep out of Git)
# DEPLOY_ROOT=C:\GATC\gatc-vps
