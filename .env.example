# Copy to .env and fill in values. Never commit .env.

# Application
NODE_ENV=development
APP_NAME=gatc-vps
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info

# Backend
API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:5173

# Public HTTPS (VPS Caddy on :443 after Admin-Free443-For-GATC.ps1 reclaim)
PUBLIC_API_URL=https://gatc.yesweigh.in

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:3000
# Android / external clients on VPS: use PUBLIC_API_URL instead of localhost.

# Database (PostgreSQL; localhost only on VPS)
# Role and database names are both `gatc`.
# Placeholder only — never commit real credentials:
# DATABASE_URL=postgresql://gatc:CHANGE_ME@127.0.0.1:5432/gatc
DATABASE_URL=

# Filesystem data root (VPS: C:\GATC\data — Mac: absolute path under the repo or ~/gatc-data)
DATA_ROOT=

# Auth (required for M1 JWT; placeholder only — use a long random string on VPS)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Login OTP (password step then SMS OTP to users.phone)
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Server-only master OTP for ADMIN (super admin). Never put in client JS.
# MASTER_OTP=
# ADMIN_MASTER_OTP=

# SMS provider for login OTP
# SMS_PROVIDER=log|http|msg91|whatsapp
#   log  — default outside production; OTP written to server logs only (never in HTTP)
#   http — POST {to,message,sender?} to SMS_API_URL with Bearer SMS_API_KEY
#   msg91 — MSG91 flow API (needs SMS_MSG91_TEMPLATE_ID; template var OTP/var)
#   whatsapp — Meta Cloud API template (service.yesweigh.in dealer OTP: template `otp`)
# Production should set SMS_PROVIDER=http|msg91|whatsapp plus credentials (never commit secrets).
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=
SMS_MSG91_TEMPLATE_ID=
# SMS_MSG91_BASE_URL=https://control.msg91.com/api/v5/flow
# Temporary only while SMS_PROVIDER=log: write OTP to server logs (never HTTP). Remove when SMS is live.
# SMS_LOG_OTP=1
#
# WhatsApp Cloud API (preferred). Prefer secrets file on VPS; do not commit tokens.
# WHATSAPP_SECRETS_FILE=C:\GATC\secrets\whatsapp-cloud.gatcdev.json
# SMS_PROVIDER=whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_OTP_TEMPLATE=otp
# WHATSAPP_OTP_LANGUAGE=en_US
# WHATSAPP_GRAPH_VERSION=v21.0

# Local/dev seed only (npm run db:seed). Never commit real passwords.
# Seed Aadhaar IDs: 999999999901 (ADMIN), 999999999902 (RC_ADMIN), 999999999903 (VCT)
SEED_PASSWORD=
# FORCE_SEED=1

# Future: government portal (manual operator-assisted only)
# EMAAP_PORTAL_URL=
# EMAAP_API_BASE_URL=
# Optional override for eMaap session status JSON (default: $DATA_ROOT/emaap/session-status.json).
# Written by an operator-assisted automation worker after manual login — never commit this file.
# EMAAP_SESSION_STATUS_PATH=
# Portal credentials (User ID / Password / Master OTP) are stored encrypted at
# $DATA_ROOT/emaap/credentials.enc.json via PUT /api/v1/admin/integrations/emaap — never commit.

# Zoho Books OAuth (India DC). Same Bench Cloud server client as ecs.benchpc.online
# (/opt/scale-bridge/.env ZOHO_BOOKS_CLIENT_* / ZOHO_CLIENT_*).
# Authorize with the Console-registered ECS callback. After Accept, ECS completes
# OAuth via POST/GET /api/v1/integrations/zoho/oauth/complete (JSON) and postMessages
# the org picker to the GATC opener — browser does not hop to gatc.yesweigh.in mid-callback.
#   https://ecs.benchpc.online/api/integrations/zoho/callback
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# Optional one-time bootstrap only — remove after Disconnect so UI stays Not connected.
# ZOHO_REFRESH_TOKEN=
# ZOHO_ORGANIZATION_ID=60001225303
# ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
# ZOHO_REDIRECT_URI=https://ecs.benchpc.online/api/integrations/zoho/callback
# Encrypted tokens land at $DATA_ROOT/zoho/credentials.enc.json — never commit.

# Razorpay — prefer UI Configure (encrypted $DATA_ROOT/razorpay/credentials.enc.json).
# Optional env bootstrap only when the encrypted file is missing:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook HMAC secret (also savable via Configure UI). Public callback:
#   https://gatc.yesweigh.in/api/v1/integrations/razorpay/webhook
# RAZORPAY_WEBHOOK_SECRET=
# PUBLIC_API_URL=https://gatc.yesweigh.in
# YESONE_INBOUND_SECRET=
# EMAAP_OTP_WEBHOOK_SECRET=

# Deployment (set on VPS only; keep out of Git)
# DEPLOY_ROOT=C:\GATC\gatc-vps
