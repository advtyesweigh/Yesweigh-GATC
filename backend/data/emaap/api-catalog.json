{
  "version": 1,
  "source": "eMAAP frontend (emaap.gov.in/gatc) + CertificateWorker / EmaapEngine usage",
  "updatedAt": "2026-11-14",
  "baseUrl": "https://emaap.gov.in/gatcapi",
  "notes": [
    "HTTP APIs used by the government eMaap GATC portal (gatcapi).",
    "CertificateWorker / EmaapEngine automate the portal UI; these are the underlying REST paths observed in portal JS.",
    "Do not store or display portal User ID, password, or Master OTP in this catalog."
  ],
  "v1": [
    { "method": "GET", "path": "/api/v1/act-and-rules/all", "description": "List act and rules documents." },
    { "method": "GET", "path": "/api/v1/act-rules-category/all", "description": "List act/rules categories." },
    { "method": "GET", "path": "/api/v1/act-rules-subcategory/all", "description": "List act/rules subcategories." },
    { "method": "GET", "path": "/api/v1/auth/access/district/dropdown", "description": "District dropdown for a state (?state_code=)." },
    { "method": "POST", "path": "/api/v1/auth/login", "description": "User login + captcha; starts OTP challenge (Send OTP)." },
    { "method": "POST", "path": "/api/v1/auth/logout", "description": "End user session." },
    { "method": "POST", "path": "/api/v1/auth/refresh", "description": "Refresh user access token." },
    { "method": "POST", "path": "/api/v1/auth/sendOtp", "description": "Resend login OTP to email." },
    { "method": "POST", "path": "/api/v1/auth/verifyOtp", "description": "Verify login OTP and establish session." },
    { "method": "POST", "path": "/api/v1/certificate/generate-gatc", "description": "Generate Self Manufacture / GATC certificate (?record_id=)." },
    { "method": "POST", "path": "/api/v1/certificate/generate-third-party", "description": "Generate 3rd-party instrument certificate (?record_id=)." },
    { "method": "POST", "path": "/api/v1/certificate/nomination/generate-gatc", "description": "Generate director-nomination GATC certificate (?record_id=)." },
    { "method": "POST", "path": "/api/v1/certificate/uploadSignedPdfManual", "description": "Upload manually DSC-signed certificate PDF." },
    { "method": "GET", "path": "/api/v1/controller/all", "description": "List controller/master reference rows." },
    { "method": "GET", "path": "/api/v1/faq/all", "description": "List FAQ entries." },
    { "method": "GET", "path": "/api/v1/form/checklist/download-pdf", "description": "Download checklist PDF (?recordId=)." },
    { "method": "GET", "path": "/api/v1/form/checklist/list", "description": "List checklist items for a form/record." },
    { "method": "POST", "path": "/api/v1/form/checklist/upload-doc", "description": "Upload checklist supporting document." },
    { "method": "GET", "path": "/api/v1/form/fields", "description": "Load dynamic form field definitions." },
    { "method": "GET", "path": "/api/v1/form/files/:path", "description": "Download or preview stored form/certificate file." },
    { "method": "GET", "path": "/api/v1/form/list", "description": "List form submissions / records." },
    { "method": "POST", "path": "/api/v1/form/pao-confirm-payment", "description": "Confirm PAO payment for a form." },
    { "method": "GET", "path": "/api/v1/form/public/fields", "description": "Public (unauthenticated) form field definitions." },
    { "method": "POST", "path": "/api/v1/form/save", "description": "Save generic dynamic form payload." },
    { "method": "GET", "path": "/api/v1/judgement-category/all", "description": "List judgement categories." },
    { "method": "GET", "path": "/api/v1/judgement/all", "description": "List judgements." },
    { "method": "POST", "path": "/api/v1/process-history/add", "description": "Append process-history entry." },
    { "method": "GET", "path": "/api/v1/process-history/list", "description": "List process-history entries." },
    { "method": "POST", "path": "/api/v1/state-process-history/add", "description": "Append state process-history entry." },
    { "method": "GET", "path": "/api/v1/state-process-history/list", "description": "List state process-history entries." },
    { "method": "GET", "path": "/api/v1/sttl/fields", "description": "Load STTL instrument form fields (?form_id=)." },
    { "method": "GET", "path": "/api/v1/sttl/list", "description": "List STTL / issued-certificate records (?form_id=…)." },
    { "method": "POST", "path": "/api/v1/sttl/save", "description": "Save / submit STTL instrument form (multipart)." },
    { "method": "GET", "path": "/api/v1/sttl/source", "description": "Dropdown source data for STTL forms (?form_id=)." },
    { "method": "GET", "path": "/api/v1/user-roles/listPublic", "description": "Public list of user roles." }
  ],
  "v2": [
    { "method": "GET", "path": "/api/v2/auth/admin/admin-list", "description": "List admin accounts (admin portal)." },
    { "method": "POST", "path": "/api/v2/auth/admin/login", "description": "Admin login (starts admin OTP flow)." },
    { "method": "POST", "path": "/api/v2/auth/admin/logout", "description": "End admin session." },
    { "method": "POST", "path": "/api/v2/auth/admin/refresh", "description": "Refresh admin access token." },
    { "method": "POST", "path": "/api/v2/auth/admin/sendOtp", "description": "Send / resend admin login OTP." },
    { "method": "POST", "path": "/api/v2/auth/admin/verifyOtp", "description": "Verify admin OTP and establish session." },
    { "method": "POST", "path": "/api/v2/requested/requested-registration", "description": "Submit registration request." },
    { "method": "GET", "path": "/api/v2/requested/validate-registration-token", "description": "Validate registration invite token." }
  ]
}
